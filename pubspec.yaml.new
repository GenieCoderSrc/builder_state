name: builder_state
description: "A simple and customizable Flutter package to easily handle different states (loading, success, error, no data) when working with asynchronous operations like FutureBuilder. Includes ready-to-use widgets for loading screens, error displays, and empty state views. Ideal for building clean and responsive UIs with minimal boilerplate."
version: 0.0.8
homepage: https://github.com/GenieCoderSrc/builder_state
repository: https://github.com/GenieCoderSrc/builder_state
issue_tracker: https://github.com/GenieCoderSrc/builder_state/issues


environment:
  sdk: \x27>=3.6.0 <4.0.0\x27

    flutter: ">=3.0.0"
